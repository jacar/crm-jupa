{
    "name": "crm-jupa",
    "version": "1.0.0",
    "private": true,
    "packageManager": "npm@10.8.2",
    "workspaces": [
        "apps/*",
        "packages/*"
    ],
    "scripts": {
        "dev": "turbo dev",
        "build": "turbo build",
        "lint": "turbo lint",
        "test": "turbo test",
        "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json}\"",
        "db:generate": "cd apps/api && npx prisma generate",
        "db:push": "cd apps/api && npx prisma db push",
        "db:migrate": "cd apps/api && npx prisma migrate dev",
        "db:seed": "cd apps/api && npx prisma db seed",
        "db:studio": "cd apps/api && npx prisma studio"
    },
    "devDependencies": {
        "prettier": "^3.2.0",
        "turbo": "^2.0.0",
        "typescript": "^5.4.0"
    },
    "engines": {
        "node": ">=20.0.0"
    },
    "dependencies": {
        "@swc/helpers": "^0.5.17",
        "bcryptjs": "^3.0.3",
        "path-scurry": "^2.0.2",
        "process": "^0.11.10",
        "styled-jsx": "^5.1.7"
    }
}
